{
  "defaultDeviceId": "local-pc",
  "devices": [
    {
      "deviceId": "local-pc",
      "name": "CONTROLLER-PC",
      "enabled": true,
      "local": true,
      "token": "replace-with-a-random-token-at-least-32-characters",
      "notes": "Controller host; native Windows Desktop Commander"
    },
    {
      "deviceId": "remote-worker",
      "name": "REMOTE-WORKER",
      "enabled": true,
      "local": false,
      "token": "replace-with-a-different-random-token-at-least-32-characters",
      "allowedIps": ["192.168.1.50", "100.64.0.2"],
      "notes": "Remote worker; allowlist its LAN and/or Tailscale source IPs",
      "pathMappings": [
        {
          "from": "C:\\",
          "to": "/host"
        }
      ]
    }
  ]
}
