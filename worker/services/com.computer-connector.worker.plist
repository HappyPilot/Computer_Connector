<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.computer-connector.worker</string>
	<key>ProgramArguments</key>
	<array>
		<string>__NODE_BINARY__</string>
		<string>__REPO_ROOT__/worker/agent.mjs</string>
		<string>__WORKER_ENV__</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__REPO_ROOT__/worker</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/com.computer-connector.worker.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/com.computer-connector.worker.error.log</string>
</dict>
</plist>
